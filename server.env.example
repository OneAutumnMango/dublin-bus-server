# Copy to server.env (gitignored) and fill in real values.

# --- Required ---------------------------------------------------------------
# NTA GTFS-Realtime key from https://developer.nationaltransport.ie/signup
GTFSR_API_KEY=
# Optional second, unlinked key. Each key allows one upstream call per 60s, so a
# second key doubles the budget (poll twice as often, or poll twice as many feeds).
GTFSR_API_KEY_SECONDARY=

# --- Optional ---------------------------------------------------------------
PORT=8080

# Which feeds to poll: TRIP_UPDATES (arrivals), VEHICLES (live positions),
# COMBINED (both plus service alerts). Comma separated.
FEEDS=TRIP_UPDATES,VEHICLES

# How often one full cycle runs. A cycle fetches every feed above once, so the
# upstream rate is (feeds x 60000 / POLL_INTERVAL_MS) calls per minute against a
# budget of one call per 60s per key. Leave blank for the fastest safe value.
POLL_INTERVAL_MS=

# How many past snapshots of each feed to retain. This is the backlog that powers
# /v1/vehicles/{id}/history; reachable history is roughly
# HISTORY_DEPTH x POLL_INTERVAL_MS. Higher values cost memory.
HISTORY_DEPTH=30

# Refuse to start when the poll rate would breach the NTA fair-usage limit.
# Set true only if you know your keys have a raised limit.
ALLOW_UNSAFE_POLL_RATE=false

# Where the filtered static GTFS bundle lives. In Docker this defaults to the
# /data volume and is generated on first start.
GTFS_STATIC_PATH=

# How often (in hours) the server re-downloads and re-filters the static GTFS bundle on its
# own, so it self-heals when NTA revises the schedule. Defaults to 24.
GTFS_REFRESH_INTERVAL_HOURS=

# Push URL for a self-hosted ntfy topic, e.g. http://ntfy:80/dbus-alerts. Blank disables alerting.
NTFY_URL=

# How much to send: off, error (startup failures only), warn (+ a feed going stale or
# recovering), info (+ every single poll failure). Defaults to info.
NTFY_LEVEL=
